# =============================================================================
# JobHunter AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jobhunter:changeme@localhost:5432/jobhunter
DATABASE_URL_SYNC=postgresql+psycopg2://jobhunter:changeme@localhost:5432/jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobhunter
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id
TELEGRAM_LOG_CHAT_ID=your-telegram-user-id

# -----------------------------------------------------------------------------
# Candidate Profile
# -----------------------------------------------------------------------------
CANDIDATE_NAME=Priyanshu Rai
CANDIDATE_EMAIL=ppprai1712@gmail.com
CANDIDATE_PHONE=8103723400
CANDIDATE_COUNTRY=India
CANDIDATE_CURRENT_POSITION=Software Engineer
CANDIDATE_CURRENT_COMPANY=Park+
CANDIDATE_EXPERIENCE_YEARS=1

# -----------------------------------------------------------------------------
# Job Filters
# -----------------------------------------------------------------------------
MIN_SALARY_LPA=15
MIN_MATCH_SCORE=85
MIN_EXPERIENCE_YEARS=1
MAX_EXPERIENCE_YEARS=4
TARGET_ROLES=Backend Engineer,Software Engineer,Python Developer,Django Developer,SDE-1,SDE-2

# -----------------------------------------------------------------------------
# Candidate Skills
# -----------------------------------------------------------------------------
CANDIDATE_SKILLS=Python,Django,REST APIs,MySQL,PostgreSQL,Redis,Celery,Docker,Git,Linux,Web Scraping,Distributed Systems,Backend Engineering

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
DISCOVER_INTERVAL_HOURS=2
SALARY_ESTIMATE_INTERVAL_HOURS=2.5
MATCH_INTERVAL_HOURS=3
APPLY_INTERVAL_HOURS=4
CLEANUP_HOUR=3
STATS_HOUR=23
STATS_MINUTE=55
HEALTH_CHECK_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
MAX_CONCURRENT_APPLICATIONS=3
MAX_APPLICATION_RETRIES=3
APPLICATION_RETRY_DELAY_SECONDS=30
MAX_DAILY_APPLICATIONS=50

# -----------------------------------------------------------------------------
# Job Sources (comma-separated board tokens)
# Format: provider:board_token
# -----------------------------------------------------------------------------
# Greenhouse boards
GREENHOUSE_BOARDS=stripe,airbnb,coinbase,notion,figma,datadog,cloudflare,vercel,supabase
# Lever companies
LEVER_COMPANIES=stripe,netflix,twitch
# Ashby boards
ASHBY_BOARDS=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
DATA_DIR=/app/data
RESUME_DIR=/app/data/resumes
SCREENSHOT_DIR=/app/data/screenshots
HTML_SNAPSHOT_DIR=/app/data/html_snapshots
REPORT_DIR=/app/data/reports
EXPORT_DIR=/app/data/exports

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/jobhunter.log

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
